# LLM provider — chọn 1 trong 2 (hoặc cả hai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Server
HOST=0.0.0.0
PORT=8000

# CORS — danh sách origin phân cách bởi dấu phẩy
CORS_ORIGINS=http://localhost:3000

# Knowledge base path (tương đối so với repo root)
KNOWLEDGE_DIR=../knowledge
