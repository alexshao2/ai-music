# --- LLM (OpenAI-compatible) ---
# Generic endpoint — works with OpenAI, Anthropic-via-proxy, vLLM, llama.cpp, ollama, etc.
# These three OVERRIDE the legacy OPENAI_* vars below.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional tuning:
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1500
# LLM_TIMEOUT_SEC=90

# --- Embedding (RAG) ---
# Chat model và embedding model là 2 entity khác nhau ở hầu hết providers
# (OpenAI: /v1/chat/completions vs /v1/embeddings; các router như 9Router,
# OpenRouter cũng tách riêng quota/permission). Cấu hình độc lập ở đây. Bất kỳ
# field nào bỏ trống sẽ fallback về LLM_* tương ứng để không phá setup cũ.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Để trống / 0 = provider tự chọn dim (an toàn nhất cho BGE/e5/Ollama).
# Chỉ set khi bạn biết provider hỗ trợ `dimensions` (OpenAI text-embedding-3-*).
# EMBEDDING_DIMENSIONS=1536

# Legacy fallbacks (still respected if LLM_* are empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Knowledge base ---
KNOWLEDGE_DIR=../knowledge
