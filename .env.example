# =============================================================================
# Self-host (docker compose) environment template.
# Copy to `.env` and fill in. Never commit `.env`.
# =============================================================================

# --- Cloudflare Tunnel ---------------------------------------------------------
# Token from Cloudflare Zero Trust → Networks → Tunnels → <your tunnel> →
# "Install and run a connector". Single token routes multiple public hostnames
# to the internal compose services (frontend:3000, backend:8000).
TUNNEL_TOKEN=

# --- Public URLs (used by the frontend build) ---------------------------------
# The PUBLIC URL the user's browser will use to reach the backend API. For
# tunnel deployments this is typically the api.* hostname configured in the
# Zero Trust dashboard's Public Hostnames page (e.g. https://api.example.com).
# Baked into the Next.js client bundle at build time, so changing it requires
# `docker compose build frontend`.
PUBLIC_API_BASE=http://localhost:8000

# CORS allow-list for the backend. Include every public origin that will load
# the frontend (comma-separated). For tunnel deployments include your public
# frontend hostname, e.g. https://music.example.com.
CORS_ORIGINS=http://localhost:3000

# --- LLM (OpenAI-compatible endpoint) -----------------------------------------
# These three OVERRIDE the legacy OPENAI_* vars below.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Legacy fallbacks (still respected if LLM_* are empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Host port mapping (optional) ---------------------------------------------
# Cổng trên HOST mà docker map ra (container vẫn nghe 8000/3000 nội bộ — không
# đổi). Default đặt lệch khỏi 3000/8000 để tránh xung đột với dev server đang
# chạy sẵn. Đổi tuỳ máy nếu cần.
# Trong deployment pure-tunnel có thể bỏ luôn block `ports:` trong
# docker-compose.yml để service không lộ ra LAN.
BACKEND_HOST_PORT=18000
FRONTEND_HOST_PORT=13000
